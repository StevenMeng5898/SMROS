/target/
/target/posix/
/host_shared/posixtest/
/host_shared/.posixtest.tmp-*/
/host_shared/.posixtest.old-*/
/host_shared/.smros-posix-stage-quarantine/
/kernel8.img
/smros-fxfs.img
