/smros-vm-launcher.log
/smros-vm-launcher.pid
/.tools/
/.worktrees/
/tests/host/target/
/verification/*/target/

# Local verification run output. Test and campaign runs may rewrite everything
# in this directory. The README stays tracked. Published records live under
# verification/evidence/ and no run writes that tree.
/verification/logs/**
!/verification/logs/README.md

# Log files anywhere else (serial captures, QEMU, launcher, coverage).
# Published serials are *.log.gz under verification/evidence/, not *.log.
*.log
!verification/evidence/**/*.log

# Python bytecode written when a script is imported without PYTHONDONTWRITEBYTECODE.
__pycache__/
*.py[cod]

# Editor and OS junk
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# Host-built pthread/futex demo binary
/src/user_level/apps/pthread_mutex_futex

# Host-built ARM NEON tensor-mul demo binaries
/src/user_level/apps/tensor_neon_mul
/src/user_level/apps/tensor_neon_mul.host
/src/user_level/apps/pthread_mutex_futex.elf
/src/user_level/apps/tensor_neon_mul.elf
/src/user_level/apps/epoll_coro.elf
/src/user_level/apps/epoll_coro.a
